NODE_ENV=development
PORT=5180
APP_ORIGIN=http://localhost:5174
# Leave MONGODB_URI empty for npm run dev to start the local MongoDB replica set.
# For Atlas, paste your connection URI into an untracked .env file.
MONGODB_URI=
# Set a random secret with at least 32 characters in production.
# Local development creates a persistent secret under .data.
JWT_SECRET=
UPLOAD_DIR=.data/uploads
# Production defaults to GridFS; local development defaults to filesystem.
UPLOAD_STORAGE=filesystem
# Set to 1 only behind one trusted reverse proxy, such as Render.
TRUST_PROXY_HOPS=0
