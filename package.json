{
  "name": "reviewroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "db:start": "node scripts/mongo.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:api": "node --test --test-concurrency=1 tests/api.test.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "format": "prettier --write client server scripts tests README.md"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.31.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.6.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
